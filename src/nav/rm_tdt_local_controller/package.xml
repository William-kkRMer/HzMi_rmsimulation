<?xml version="1.0"?>
<package format="3">
  <name>rm_tdt_local_controller</name>
  <version>0.1.0</version>
  <description>T-DT 局部规划即控制器：全局 A* 给路径，局部 KinodynamicAstar(4 m) 出轨迹，按轨迹前馈+反馈出速度</description>
  <maintainer email="dev@hzmi.local">HzMi</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>pluginlib</depend>
  <depend>eigen</depend>
  <depend>rm_tdt_planner</depend>
  <depend>rm_plan_msgs</depend>
  <export><build_type>ament_cmake</build_type></export>
  <depend>rm_nav_interfaces</depend>
</package>
