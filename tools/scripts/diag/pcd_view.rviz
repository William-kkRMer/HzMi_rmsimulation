Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /PCD1
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Alpha: 0.25
    - Class: rviz_default_plugins/PointCloud2
      Name: PCD1
      Enabled: true
      Topic:
        Value: /cloud_pcd
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 1
  Enabled: true
  Global Options:
    Background Color: 25; 25; 28
    Fixed Frame: map
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.55
      Yaw: 0.9
      Name: Current View
      Target Frame: map
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
